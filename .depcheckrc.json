{
  "ignoreMatches": [
    "@nuxt/*",
    "@vue/*",
    "@vitest/*",
    "@playwright/*",
    "@eslint/*",
    "eslint-*",
    "prettier",
    "typescript",
    "vitest",
    "playwright",
    "happy-dom",
    "vue-eslint-parser",
    "highlight.js",
    "vue-router",
    "@nuxt/test-utils",
    "@vue/test-utils",
    "tsx",
    "vue-tsc"
  ],
  "ignorePatterns": [
    "node_modules",
    ".nuxt",
    ".output",
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    "tests/**/*"
  ],
  "skipMissing": true
}
