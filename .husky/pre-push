#!/bin/sh
# Enforce linting on push to prevent broken code from being pushed

echo "Running lint checks before push..."

# Run ESLint
if ! npm run lint; then
  echo "❌ ESLint check failed. Push aborted."
  echo "Please fix the linting errors and try again."
  exit 1
fi

# Run Prettier check
if ! npm run format:check; then
  echo "❌ Prettier format check failed. Push aborted."
  echo "Please run 'npm run format' to fix formatting issues and try again."
  exit 1
fi

echo "✅ All lint checks passed. Proceeding with push..."