{
  "name": "tools.tomacheese.com",
  "version": "1.0.0",
  "description": "プライバシー重視のWebツールサイト - すべてのツールをクライアントサイドで提供",
  "author": "tomacheese",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomacheese/tools.tomacheese.com.git"
  },
  "homepage": "https://tomacheese.github.io/tools.tomacheese.com/",
  "keywords": [
    "tools",
    "utilities",
    "web-tools",
    "privacy",
    "client-side",
    "nuxt",
    "vue",
    "typescript",
    "tailwind"
  ],
  "engines": {
    "node": "24.10.0",
    "pnpm": "10.18.3"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "shamefullyHoist": false,
    "strictPeerDependencies": false,
    "autoInstallPeers": true,
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,js,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,js,css,scss}\"",
    "typecheck": "nuxi typecheck",
    "depcheck": "depcheck",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "ntl deploy --prod",
    "docker:build": "docker build -t tools-tomacheese .",
    "docker:run": "docker run -p 3000:80 tools-tomacheese",
    "docker:dev": "docker-compose --profile dev up",
    "docker:prod": "docker-compose up -d",
    "prepare": "husky"
  },
  "dependencies": {
    "diff": "8.0.2",
    "highlight.js": "11.11.1",
    "jsqr": "1.4.0",
    "marked": "16.4.1",
    "nuxt": "3.19.3",
    "qrcode": "1.5.4",
    "vue": "3.5.22",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@nuxt/test-utils": "3.19.2",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.11",
    "@types/qrcode": "1.5.5",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/parser": "8.46.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "@vue/test-utils": "2.4.6",
    "depcheck": "1.4.7",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.5.1",
    "happy-dom": "20.0.4",
    "husky": "9.1.7",
    "lint-staged": "16.2.4",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "serve": "14.2.5",
    "tsx": "4.20.6",
    "vitest": "3.2.4",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.1.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,html,json,md}": [
      "prettier --write"
    ]
  }
}
