{
  "name": "tools.tomacheese.com",
  "version": "1.0.0",
  "description": "便利なWebツール集 - クライアントサイドで動作するプライバシー重視のツールサイト",
  "author": "tomacheese",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomacheese/tools.tomacheese.com.git"
  },
  "homepage": "https://tomacheese.github.io/tools.tomacheese.com/",
  "keywords": [
    "tools",
    "utilities",
    "web-tools",
    "javascript",
    "nuxt",
    "vue"
  ],
  "engines": {
    "node": ">=20.15.1",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.9",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,js,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,js,css,scss}\"",
    "typecheck": "nuxi typecheck",
    "depcheck": "depcheck",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "ntl deploy --prod",
    "docker:build": "docker build -t tools-tomacheese .",
    "docker:run": "docker run -p 3000:80 tools-tomacheese",
    "docker:dev": "docker-compose --profile dev up",
    "docker:prod": "docker-compose up -d"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "highlight.js": "^11.11.1",
    "marked": "^16.1.1",
    "nuxt": "3.17.7",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.19.2",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "depcheck": "^1.4.7",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.3.0",
    "happy-dom": "^18.0.0",
    "playwright": "^1.54.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0"
  }
}
